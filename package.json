{
  "name": "chatgpt-web-v2",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Offline-testable OpenAI-compatible ChatGPT web protocol service",
  "type": "module",
  "engines": {
    "node": ">=24.11.1 <25"
  },
  "scripts": {
    "start": "node --experimental-strip-types src/server.ts",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "typecheck": "npx tsc --noEmit --target ES2022 --module NodeNext --moduleResolution NodeNext --skipLibCheck",
    "syntax:check": "node scripts/check-syntax.mjs",
    "integrity:verify": "node scripts/verify-omniroute-integrity.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0"
  },
  "dependencies": {
    "tls-client-node": "0.2.0"
  }
}
